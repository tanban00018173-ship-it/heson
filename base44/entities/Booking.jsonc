{
  "name": "Booking",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "\u5ba2\u6236 ID"
    },
    "cleaner_id": {
      "type": "string",
      "description": "\u6307\u6d3e\u7684\u7ba1\u7406\u5e2b ID"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "\u57fa\u790e\u6708\u8b77-4\u6b21",
        "\u9032\u968e\u6708\u5b89-8\u6b21",
        "\u5c0a\u69ae\u6708\u6046-12\u6b21",
        "\u55ae\u6b21\u6e05\u6f54",
        "\u8f15\u91cf\u6e05\u6f54",
        "\u5927\u6383\u9664",
        "\u88dd\u6f62\u5f8c\u6e05\u6f54",
        "\u6c11\u5bbf\u6e05\u6f54"
      ],
      "description": "\u670d\u52d9\u985e\u578b"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u5f85\u78ba\u8a8d",
        "\u5df2\u78ba\u8a8d",
        "\u9032\u884c\u4e2d",
        "\u5f85\u7d50\u7b97",
        "\u5df2\u5b8c\u6210",
        "\u5df2\u53d6\u6d88",
        "\u6263\u7559\u4e2d"
      ],
      "description": "\u9810\u7d04\u72c0\u614b"
    },
    "is_flash_task": {
      "type": "boolean",
      "description": "\u662f\u5426\u70ba\u9583\u96fb\u4efb\u52d9\uff08\u5ba2\u6236\u5373\u6642\u767c\u8d77\uff0c\u7b49\u5f85\u6e05\u6f54\u5e2b\u63a5\u55ae\uff09",
      "default": false
    },
    "flash_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u9583\u96fb\u4efb\u52d9\u904e\u671f\u6642\u9593\uff08\u901a\u5e38\u767c\u8d77\u5f8c2\u5c0f\u6642\uff09"
    },
    "hold_status": {
      "type": "string",
      "enum": [
        "\u9650\u671f\u88dc\u6b63",
        "\u9000\u6b3e\u8655\u7406\u4e2d",
        "\u5df2\u89e3\u9664"
      ],
      "description": "\u6263\u7559\u72c0\u614b\uff08\u6263\u7559\u4e2d\u6642\u4f7f\u7528\uff09"
    },
    "hold_reason": {
      "type": "string",
      "description": "\u6263\u7559\u539f\u56e0"
    },
    "hold_refund_percent": {
      "type": "number",
      "enum": [
        0,
        20,
        50,
        100
      ],
      "description": "\u9000\u6b3e\u767e\u5206\u6bd4\uff080/20/50/100\uff09"
    },
    "auto_complete_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u9810\u8a08\u81ea\u52d5\u7d50\u6848\u6642\u9593\uff08\u670d\u52d9\u5b8c\u6210\u5f8c24hr\uff09"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "\u9810\u7d04\u65e5\u671f"
    },
    "time_slot": {
      "type": "string",
      "enum": [
        "\u4e0a\u5348 08:00-12:00",
        "\u4e0b\u5348 13:00-17:00",
        "\u665a\u9593 18:00-21:00"
      ],
      "description": "\u6642\u6bb5"
    },
    "address": {
      "type": "string",
      "description": "\u670d\u52d9\u5730\u5740"
    },
    "gps_lat": {
      "type": "number",
      "description": "\u670d\u52d9\u5730\u9ede\u7def\u5ea6"
    },
    "gps_lng": {
      "type": "number",
      "description": "\u670d\u52d9\u5730\u9ede\u7d93\u5ea6"
    },
    "phone": {
      "type": "string",
      "description": "\u806f\u7d61\u96fb\u8a71"
    },
    "notes": {
      "type": "string",
      "description": "\u5099\u8a3b"
    },
    "client_name": {
      "type": "string",
      "description": "\u5ba2\u6236\u59d3\u540d"
    },
    "cleaner_name": {
      "type": "string",
      "description": "\u7ba1\u7406\u5e2b\u59d3\u540d"
    },
    "confirmed_by_cleaner": {
      "type": "boolean",
      "description": "\u7ba1\u7406\u5e2b\u662f\u5426\u5df2\u78ba\u8a8d\u4e0a\u5de5"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "\u5f85\u4ed8\u6b3e",
        "\u5df2\u4ed8\u6b3e",
        "\u5df2\u9000\u6b3e"
      ],
      "description": "\u4ed8\u6b3e\u72c0\u614b"
    },
    "amount": {
      "type": "number",
      "description": "\u8a02\u55ae\u91d1\u984d"
    }
  },
  "required": [
    "client_id",
    "service_type",
    "scheduled_date",
    "time_slot"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.cleaner_id": "{{user.id}}"
        },
        {
          "data.is_flash_task": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "data.cleaner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}