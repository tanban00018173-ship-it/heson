{
  "name": "HomeSection",
  "type": "object",
  "properties": {
    "section_key": {
      "type": "string",
      "enum": [
        "flash",
        "featured_cleaners",
        "deep_clean",
        "appliance",
        "recurring",
        "fabric",
        "organize"
      ],
      "description": "\u6240\u5c6c\u6a21\u584a key\uff08\u5c0d\u61c9\u9996\u9801\u5404\u5206\u985e\uff09"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "cleaner",
        "vendor"
      ],
      "description": "\u4e0a\u67b6\u8005\u985e\u578b\uff1a\u5e2b\u5085 or \u5ee0\u5546"
    },
    "provider_id": {
      "type": "string",
      "description": "\u5e2b\u5085\u7684 user_id \u6216\u5ee0\u5546\u7684 vendor_id"
    },
    "provider_name": {
      "type": "string",
      "description": "\u986f\u793a\u540d\u7a31"
    },
    "title": {
      "type": "string",
      "description": "\u5361\u7247\u6a19\u984c\uff08\u670d\u52d9\u540d\u7a31\uff09"
    },
    "subtitle": {
      "type": "string",
      "description": "\u5361\u7247\u526f\u6a19\u984c\uff08\u7c21\u77ed\u63cf\u8ff0\uff09"
    },
    "price": {
      "type": "number",
      "description": "\u8d77\u59cb\u50f9\u683c\uff08NT$\uff09"
    },
    "image_url": {
      "type": "string",
      "description": "\u5361\u7247\u5716\u7247 URL"
    },
    "badge": {
      "type": "string",
      "description": "\u6a19\u7c64\u6587\u5b57\uff08\u5982\uff1a\u71b1\u9580\u3001\u9650\u5b9a\uff09"
    },
    "emoji": {
      "type": "string",
      "description": "\u5361\u7247 emoji \u5716\u793a\uff08\u7121\u5716\u6642\u986f\u793a\uff09",
      "default": "\ud83e\uddf9"
    },
    "service_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u53ef\u670d\u52d9\u7684\u5730\u5340\uff08\u7e23\u5e02/\u884c\u653f\u5340\uff09"
    },
    "gps_lat": {
      "type": "number",
      "description": "\u5e2b\u5085/\u5ee0\u5546\u6240\u5728\u5730\u7def\u5ea6"
    },
    "gps_lng": {
      "type": "number",
      "description": "\u5e2b\u5085/\u5ee0\u5546\u6240\u5728\u5730\u7d93\u5ea6"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u662f\u5426\u4e0a\u67b6\u986f\u793a"
    },
    "sort_order": {
      "type": "number",
      "default": 99,
      "description": "\u6392\u5e8f\uff08\u6578\u5b57\u8d8a\u5c0f\u8d8a\u524d\u9762\uff09"
    },
    "click_count": {
      "type": "number",
      "default": 0,
      "description": "\u88ab\u9ede\u64ca\u6b21\u6578\uff08\u6f14\u7b97\u6cd5\u6b0a\u91cd\u53c3\u8003\uff09"
    },
    "booking_count": {
      "type": "number",
      "default": 0,
      "description": "\u4fc3\u6210\u9810\u7d04\u6b21\u6578\uff08\u6f14\u7b97\u6cd5\u6b0a\u91cd\uff09"
    }
  },
  "required": [
    "section_key",
    "provider_type",
    "title"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {},
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}