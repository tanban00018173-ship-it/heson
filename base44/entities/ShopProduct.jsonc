{
  "name": "ShopProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u5546\u54c1\u540d\u7a31"
    },
    "description": {
      "type": "string",
      "description": "\u5546\u54c1\u63cf\u8ff0"
    },
    "price": {
      "type": "number",
      "description": "\u552e\u50f9\uff08NT$\uff09"
    },
    "unit": {
      "type": "string",
      "description": "\u55ae\u4f4d\uff08\u74f6\u3001\u7d44\u3001\u5305\u7b49\uff09",
      "default": "\u500b"
    },
    "category": {
      "type": "string",
      "description": "\u5206\u985e\uff08\u81ea\u5b9a\u7fa9\uff09"
    },
    "tag": {
      "type": "string",
      "description": "\u6a19\u7c64\uff08\u71b1\u92b7\u3001\u65b0\u54c1\u3001\u63a8\u85a6\u7b49\uff09"
    },
    "image_url": {
      "type": "string",
      "description": "\u5546\u54c1\u5716\u7247 URL"
    },
    "stock": {
      "type": "number",
      "description": "\u5eab\u5b58\u6578\u91cf\uff08-1 \u4ee3\u8868\u7121\u9650\uff09",
      "default": -1
    },
    "is_active": {
      "type": "boolean",
      "description": "\u662f\u5426\u4e0a\u67b6",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "description": "\u6392\u5e8f\uff08\u6578\u5b57\u8d8a\u5c0f\u8d8a\u524d\u9762\uff09",
      "default": 99
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
