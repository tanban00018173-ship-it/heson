{
  "name": "UserAddress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u7528\u6236 ID"
    },
    "address_type": {
      "type": "string",
      "enum": [
        "\u5c45\u5bb6\u5730\u5740",
        "\u516c\u53f8\u5730\u5740",
        "\u5176\u4ed6\u5730\u5740",
        "\u8d85\u5546\u53d6\u8ca8\u5730\u5740"
      ],
      "description": "\u5730\u5740\u985e\u578b"
    },
    "full_name": {
      "type": "string",
      "description": "\u5168\u540d"
    },
    "phone": {
      "type": "string",
      "description": "\u624b\u6a5f\u865f\u78bc"
    },
    "city": {
      "type": "string",
      "description": "\u57ce\u5e02"
    },
    "district": {
      "type": "string",
      "description": "\u5340"
    },
    "postal_code": {
      "type": "string",
      "description": "\u90f5\u905e\u5340\u865f"
    },
    "street": {
      "type": "string",
      "description": "\u8857\u9053,\u5df7\u5f04,\u9580\u865f,\u6a13\u5c64"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "\u662f\u5426\u70ba\u9810\u8a2d\u5730\u5740"
    },
    "gps_lat": {
      "type": "number",
      "description": "\u670d\u52d9\u5730\u9ede\u7def\u5ea6\uff08\u624b\u52d5\u6821\u6b63\u5f8c\u5132\u5b58\uff09"
    },
    "gps_lng": {
      "type": "number",
      "description": "\u670d\u52d9\u5730\u9ede\u7d93\u5ea6\uff08\u624b\u52d5\u6821\u6b63\u5f8c\u5132\u5b58\uff09"
    }
  },
  "required": [
    "user_id",
    "address_type",
    "full_name",
    "phone",
    "city",
    "district",
    "street"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}